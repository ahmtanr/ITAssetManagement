@model IEnumerable<ITAssetManagement.Core.Bakim>

@{
    ViewData["Title"] = "Bakım Kayıtları";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Bakım ve Arıza Kayıtları</h3>
            <p class="text-muted small mb-0">Bakıma veya arızaya alınan cihazları takip edin.</p>
        </div>
        <a asp-action="Olustur" class="btn btn-primary fw-bold rounded-pill px-4 py-2">➕ Yeni Bakım Kaydı</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Cihaz</th>
                            <th class="py-3">Kategori</th>
                            <th class="py-3">Açıklama</th>
                            <th class="py-3">Başlangıç</th>
                            <th class="py-3">Bitiş</th>
                            <th class="py-3">Durum</th>
                            <th class="text-end pe-4 py-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.Demirbas?.Marka @item.Demirbas?.Model</td>
                                <td>@item.Demirbas?.Kategori</td>
                                <td class="text-muted">@item.Aciklama</td>
                                <td>@item.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(item.BitisTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                <td>
                                    @if (item.AktifMi)
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill">Açık</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Kapandı</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.AktifMi)
                                    {
                                        <form asp-action="Kapat" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold px-3 rounded-pill" onclick="return confirm('Bakımı kapatıp cihazı boşta olarak işaretlemek istiyor musunuz?');">Bakımı Kapat</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-muted text-center py-4">Henüz bakım kaydı yok.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
