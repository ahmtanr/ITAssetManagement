@model ITAssetManagement.Core.Talep

@{
    ViewData["Title"] = "Yeni Cihaz Talebi";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 border-0">
                    <h4 class="fw-bold mb-0 text-primary">📩 Yeni Cihaz Talep Formu</h4>
                    <small class="text-muted">İhtiyaç duyduğunuz cihazı ve gerekçesini detaylıca belirtin.</small>
                </div>
                <div class="card-body bg-light p-4 rounded-bottom-4">
                    
                    <form asp-action="Create" method="post">
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">İstenen Cihaz Türü</label>
                            <select asp-for="CihazTuru" class="form-select border-0 py-2 shadow-sm" required>
                                <option value="">-- Elimizdeki Cihazlardan Birini Seçiniz --</option>
                                
                                <!-- Veritabanından gelen cihazları listeliyoruz -->
                                @if (ViewBag.Cihazlar != null)
                                {
                                    foreach (var cihaz in ViewBag.Cihazlar)
                                    {
                                        <!-- Not: Demirbas sınıfındaki özelliklerin isimleri farklıysa (Örn: cihaz.Ad, cihaz.Kategori vb.) buraları ona göre düzenleyebilirsin -->
                                        <option value="@cihaz.Marka @cihaz.Model">@cihaz.Marka @cihaz.Model (Seri No: @cihaz.SeriNo)</option>
                                    }
                                }
                                
                                <option value="Diğer">Diğer (Listede Yok)</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Talep Gerekçesi</label>
                            <textarea asp-for="Gerekce" class="form-control border-0 shadow-sm" rows="4" placeholder="Örn: Mevcut bilgisayarımın performansı yazılım geliştirme süreçleri için yetersiz kalıyor..." required></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Vazgeç</a>
                            <button type="submit" class="btn btn-primary fw-bold px-5" style="background-color: #3b5998;">Talebi Gönder</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>