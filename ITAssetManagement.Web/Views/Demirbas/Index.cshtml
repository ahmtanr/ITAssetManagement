@model IEnumerable<ITAssetManagement.Core.Demirbas>

@{
    ViewData["Title"] = "Demirbaş Listesi";
}

<style>
    .demirbas-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 55%, #7c3aed 100%);
        color: #fff;
        border-radius: 1.25rem;
    }
</style>

<div class="container-fluid mt-4 px-4">
    <!-- Üst Başlık ve Yeni Ekle Butonu -->
    <div class="demirbas-hero p-4 p-md-5 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3 py-2 mb-2">Envanter Yönetimi</span>
                <h2 class="fw-bold mb-1">Envanter (Demirbaş) Listesi</h2>
                <p class="mb-0 opacity-75">Kurumdaki tüm cihazları buradan yönetebilir ve QR kodlarını görüntüleyebilirsiniz.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Create" class="btn btn-light fw-bold rounded-pill px-4 py-2 shadow-sm text-primary">
                    + Yeni Cihaz Ekle
                </a>
            </div>
        </div>
    </div>

    <!-- Cihazlar Tablosu -->
    <div class="card shadow-sm border-0 rounded-4 mb-5 bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Cihaz Bilgisi</th>
                            <th class="py-3">Seri No</th>
                            <th class="py-3">Barkod (QR Temeli)</th>
                            <th class="py-3">Durum</th>
                            <th class="text-end pe-4 py-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@item.Marka @item.Model</td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(item.SeriNo) ? "-" : item.SeriNo)</td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-dark font-monospace px-3 py-2 rounded-pill">@item.Barkod</span>
                                    </td>
                                    <td>
                                        @if(item.Durum == "Boşta")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold">🟢 Boşta</span>
                                        }
                                        else if(item.Durum == "Zimmetli")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">🔵 Zimmetli</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-bold">🔴 @item.Durum</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <!-- QR Kod Göster Butonu -->
                                        <button type="button" class="btn btn-sm btn-outline-dark fw-bold px-3 rounded-pill me-1" onclick="qrGoster(this.dataset.barkod, this.dataset.cihaz)" data-barkod="@item.Barkod" data-cihaz="@item.Marka @item.Model">
                                            📱 QR Kod
                                        </button>
                                        
                                        <!-- Arıza Butonları -->
                                        @if (item.Durum == "Boşta")
                                        {
                                            <a asp-controller="Bakim" asp-action="Olustur" asp-route-demirbasId="@item.Id" class="btn btn-sm btn-outline-secondary fw-bold px-3 rounded-pill me-1">🛠 Bakıma Al</a>
                                            <form asp-action="ArizaIsaretle" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-warning fw-bold px-3 rounded-pill me-1" onclick="return confirm('Bu cihazı arızalı olarak işaretlemek istiyor musunuz?');">⚠ Arızalı İşaretle</button>
                                            </form>
                                        }
                                        else if (item.Durum == "Arızalı")
                                        {
                                            <form asp-action="ArizaGider" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success fw-bold px-3 rounded-pill me-1">🔧 Arızayı Gider</button>
                                            </form>
                                        }
                                        else if (item.Durum == "Bakımda")
                                        {
                                            <a asp-controller="Bakim" asp-action="Index" class="btn btn-sm btn-outline-secondary fw-bold px-3 rounded-pill me-1">🛠 Bakımı Yönet</a>
                                        }

                                        <!-- Sil Butonu -->
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold px-3 rounded-pill" onclick="return confirm('Bu cihazı silmek istediğinize emin misiniz?');">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <h5 class="fw-bold text-secondary">Envanterde henüz kayıtlı cihaz bulunmuyor.</h5>
                                    <p class="small text-muted">Yeni cihaz eklemek için yukarıdaki butonu kullanabilirsiniz.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- QR Kod Modal (Açılır Pencere) -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="qrModalLabel">Cihaz QR Kodu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pb-4">
                <p class="text-muted small mb-3 fw-medium" id="qrCihazAdi">Yükleniyor...</p>
                
                <!-- QR Kodun Çizileceği Alan -->
                <div id="qrcode-container" class="d-flex justify-content-center p-3 bg-white border rounded-3 shadow-sm mx-auto" style="width: 180px; height: 180px;"></div>
                
                <p class="mt-3 mb-0 fw-bold text-primary font-monospace small" id="qrKodMetni"></p>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold text-muted" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- QR Kod JS Kütüphanesi ve Fonksiyonu -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    var qrcode = null;

    function qrGoster(barkod, cihazAdi) {
        document.getElementById("qrCihazAdi").innerText = cihazAdi;
        document.getElementById("qrKodMetni").innerText = barkod;
        document.getElementById("qrcode-container").innerHTML = "";

        qrcode = new QRCode(document.getElementById("qrcode-container"), {
            text: barkod,
            width: 140,
            height: 140,
            colorDark : "#000000",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.H
        });

        var myModal = new bootstrap.Modal(document.getElementById('qrModal'));
        myModal.show();
    }
</script>