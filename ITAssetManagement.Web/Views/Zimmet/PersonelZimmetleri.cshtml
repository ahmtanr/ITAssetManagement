@model IEnumerable<ITAssetManagement.Core.Zimmet>

@{
    ViewData["Title"] = "Üzerimdeki Cihazlar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold" style="color: #444;">📦 Üzerimdeki Demirbaşlar</h4>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="ps-4">Cihaz Bilgisi</th>
                        <th>Seri No</th>
                        <th>Veriliş Tarihi</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">
                                        @(item.Demirbas?.Marka) @(item.Demirbas?.Model)
                                    </span>
                                </td>
                                <td class="text-muted">
                                    @(item.Demirbas?.SeriNo ?? "Belirtilmemiş")
                                </td>
                                <td class="text-muted">@item.VerilisTarihi.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="badge bg-primary px-3 py-2 rounded-pill">🔵 Aktif Kullanımda</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <h5>Üzerinize zimmetlenmiş herhangi bir cihaz bulunmuyor.</h5>
                                <p class="small">İhtiyacınız olan cihazlar için "Cihaz Taleplerim" menüsünden talep oluşturabilirsiniz.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>