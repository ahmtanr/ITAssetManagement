@model IEnumerable<ITAssetManagement.Core.Zimmet>

@{
    ViewData["Title"] = "Zimmet Yönetimi";
}

<div class="container-fluid mt-4 px-4">
    <!-- Üst Başlık -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">📦 Zimmet Listesi (Atanan Cihazlar)</h3>
            <p class="text-muted small mb-0">Personellerde kullanımda olan cihazları takip edebilir ve iade alabilirsiniz.</p>
        </div>
    </div>

    <!-- Zimmetler Tablosu -->
    <div class="card shadow-sm border-0 rounded-4 mb-5 bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Cihaz Bilgisi</th>
                            <th class="py-3">Zimmetlenen Personel</th>
                            <th class="py-3">Veriliş Tarihi</th>
                            <th class="py-3">Durum</th>
                            <th class="text-end pe-4 py-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        @(item.Demirbas != null ? $"{item.Demirbas.Marka} {item.Demirbas.Model}" : "Bilinmeyen Cihaz")
                                        <div class="small text-muted font-monospace" style="font-size: 0.75rem;">Barkod: @(item.Demirbas?.Barkod ?? "-")</div>
                                    </td>
                                    <td class="fw-medium text-secondary">
                                        @(item.Kullanici != null ? item.Kullanici.AdSoyad ?? item.Kullanici.KullaniciAdi : "Bilinmeyen Kullanıcı")
                                    </td>
                                    <td class="text-muted small">
                                        @item.VerilisTarihi.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (item.AktifMi)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">🔵 Aktif Zimmet</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill fw-bold">⚪ İade Edildi</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.AktifMi)
                                        {
                                            <!-- İade Al Butonu -->
                                            <form asp-action="IadeEt" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-warning fw-bold px-3 rounded-pill" onclick="return confirm('Bu cihazı personelden iade almak ve depoya çekmek istediğinize emin misiniz?');">
                                                    🔄 İade Al
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">İşlem Tamamlandı</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <h5 class="fw-bold text-secondary">Sistemde kayıtlı aktif zimmet bulunmuyor.</h5>
                                    <p class="small text-muted">Personel talepleri onaylandığında cihazlar otomatik olarak buraya atanacaktır.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>