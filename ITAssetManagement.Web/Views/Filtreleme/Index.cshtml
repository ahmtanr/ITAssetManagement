@model IEnumerable<ITAssetManagement.Core.Demirbas>

@{
    ViewData["Title"] = "Gelişmiş Filtreleme";
}

<div class="container mt-4">
    <h4 class="fw-bold mb-4" style="color: #444;">♈ Cihaz Filtreleme Paneli</h4>

    <!-- Filtre Butonları -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Tüm Cihazlar</a>
            <a asp-action="Index" asp-route-durum="Zimmetli" class="btn btn-success btn-sm">Aktif Cihazlar</a>
            <a asp-action="Index" asp-route-durum="Arızalı" class="btn btn-danger btn-sm">Arızalı Cihazlar</a>
            <a asp-action="Index" asp-route-durum="Boşta" class="btn btn-warning btn-sm">Depodakiler</a>
        </div>
    </div>

    <!-- Sonuç Tablosu -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="ps-4">Marka / Model</th>
                        <th>Seri No</th>
                        <th>Barkod</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cihaz in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@cihaz.Marka - @cihaz.Model</td>
                                <td>@cihaz.SeriNo</td>
                                <td>@cihaz.Barkod</td>
                                <td>
                                    <span class="badge bg-primary px-3 py-2">@cihaz.Durum</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Bu kriterlere uygun cihaz bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>