@{
    Layout = null;
    ViewData["Title"] = "Sisteme Giriş";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Yönetim Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: linear-gradient(135deg, #eef2ff 0%, #f4f7f6 60%);
                min-height: 100vh;
                margin: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem 0;
            }

            .login-wrapper {
                width: 100%;
                max-width: 450px;
                margin: 0 auto;
            }

            .login-card {
                border: none;
                border-radius: 1.5rem;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
                overflow: hidden;
                width: 100%;
            }

            .form-control {
                border-radius: 0.75rem;
                padding: 0.85rem 1.2rem;
                background-color: #f8f9fa;
                border: 1px solid #e9ecef;
            }

                .form-control:focus {
                    box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
                    border-color: #667eea;
                    background-color: #fff;
                }

            .btn-primary {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border: none;
                border-radius: 0.75rem;
                padding: 0.85rem;
                font-weight: bold;
            }

            .nav-pills .nav-link {
                border-radius: 0.75rem;
                font-weight: 600;
                color: #6c757d;
            }

                .nav-pills .nav-link.active {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    color: white;
                }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="card login-card p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <img src="~/img/gop-logo.png" alt="Tokat Gaziosmanpaşa Üniversitesi Logosu" class="mb-3" style="width: 96px; height: 96px; object-fit: contain; background: #fff; border-radius: 50%; padding: 6px; box-shadow: 0 4px 14px rgba(102, 126, 234, 0.25);" />
                        <h3 class="fw-bold text-dark mb-1">Sisteme Giriş</h3>
                        <p class="text-muted small">Devam etmek için giriş türünü seçin.</p>
                    </div>

                    @if (TempData["BasariliMesaj"] != null)
                    {
                        <div class="alert alert-success rounded-3 small py-2 mb-3">
                            ✅ @TempData["BasariliMesaj"]
                        </div>
                    }

                    @if (ViewBag.Hata != null)
                    {
                        <div class="alert alert-danger rounded-3 small py-2 mb-3">
                            ❌ @ViewBag.Hata
                        </div>
                    }

                    <!-- Giriş Türü Seçim Sekmeleri -->
                    <ul class="nav nav-pills nav-fill mb-4 bg-light p-1 rounded-4" id="pills-tab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active py-2" id="pills-personel-tab" data-bs-toggle="pill" data-bs-target="#pills-personel" type="button" role="tab">Personel Girişi</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-2" id="pills-admin-tab" data-bs-toggle="pill" data-bs-target="#pills-admin" type="button" role="tab">Yönetici Girişi</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="pills-tabContent">
                        <!-- PERSONEL GİRİŞ FORMU -->
                        <div class="tab-pane fade show active" id="pills-personel" role="tabpanel">
                            <form asp-controller="Giris" asp-action="Index" method="post">
                                <input type="hidden" name="girisTuru" value="Personel" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Kullanıcı Adı</label>
                                    <input type="text" name="kullaniciAdi" class="form-control shadow-sm" placeholder="Kullanıcı adınızı girin" required autocomplete="off" readonly />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label text-muted small fw-bold">Şifre</label>
                                    <input type="password" name="sifre" class="form-control shadow-sm" placeholder="Şifrenizi girin" required autocomplete="new-password" readonly />
                                </div>
                                <button type="submit" class="btn btn-primary w-100 mb-3 text-white shadow">Personel Olarak Giriş Yap</button>
                            </form>
                        </div>

                        <!-- YÖNETİCİ GİRİŞ FORMU -->
                        <div class="tab-pane fade" id="pills-admin" role="tabpanel">
                            <form asp-controller="Giris" asp-action="Index" method="post">
                                <input type="hidden" name="girisTuru" value="Admin" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Yönetici Kullanıcı Adı</label>
                                    <input type="text" name="kullaniciAdi" class="form-control shadow-sm" placeholder="Yönetici adını girin" required autocomplete="off" readonly />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label text-muted small fw-bold">Yönetici Şifresi</label>
                                    <input type="password" name="sifre" class="form-control shadow-sm" placeholder="Yönetici şifresini girin" required autocomplete="new-password" readonly />
                                </div>
                                <button type="submit" class="btn btn-primary w-100 mb-3 text-white shadow">Yönetici Olarak Giriş Yap</button>
                            </form>
                        </div>
                    </div>

                    <div class="text-center mt-2">
                        <p class="text-muted small">Hesabınız yok mu? <a asp-action="KayitOl" class="text-primary fw-bold text-decoration-none">Hemen Kayıt Olun</a></p>
                    </div>
                </div>
            </div>

    <!-- Bootstrap JS (Sekmelerin çalışması için gerekli) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('input[type="text"], input[type="password"]').forEach(function (input) {
            input.value = '';
            input.addEventListener('focus', function () { input.readOnly = false; });
        });
    </script>
</body>
</html>